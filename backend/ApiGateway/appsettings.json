{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:5000"
      }
    }
  },
  "Jwt": {
    "Issuer": "EduSphereIdentity",
    "Audience": "EduSphereServices",
    "Key": "ThisIsASecretKeyForJwtSigningThatMustBeAtLeast256BitsLong!",
    "ExpiryMinutes": "60"
  },
  "ReverseProxy": {
    "Routes": {
      "identity-auth-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/auth/{**catch-all}" }
        ]
      },
      "identity-users-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/users/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/users/{**catch-all}" }
        ]
      },
      "identity-health-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/health/identity"
        },
        "Transforms": [
          { "PathPattern": "/health" }
        ]
      },
      "course-route": {
        "ClusterId": "course-cluster",
        "Match": {
          "Path": "/api/courses/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/courses/{**catch-all}" }
        ]
      },
      "course-sections-route": {
        "ClusterId": "course-cluster",
        "Match": {
          "Path": "/api/sections/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/sections/{**catch-all}" }
        ]
      },
      "course-health-route": {
        "ClusterId": "course-cluster",
        "Match": {
          "Path": "/health/course"
        },
        "Transforms": [
          { "PathPattern": "/health" }
        ]
      },
      "core-enrollments-route": {
        "ClusterId": "core-cluster",
        "Match": {
          "Path": "/api/enrollments/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/enrollments/{**catch-all}" }
        ]
      },
      "core-progress-route": {
        "ClusterId": "core-cluster",
        "Match": {
          "Path": "/api/progress/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/progress/{**catch-all}" }
        ]
      },
      "core-quizzes-route": {
        "ClusterId": "core-cluster",
        "Match": {
          "Path": "/api/quizzes/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/quizzes/{**catch-all}" }
        ]
      },
      "core-admin-route": {
        "ClusterId": "core-cluster",
        "Match": {
          "Path": "/api/admin/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/admin/{**catch-all}" }
        ]
      },
      "core-health-route": {
        "ClusterId": "core-cluster",
        "Match": {
          "Path": "/health/core"
        },
        "Transforms": [
          { "PathPattern": "/health" }
        ]
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "identity-service": {
            "Address": "http://localhost:5001"
          }
        }
      },
      "course-cluster": {
        "Destinations": {
          "course-service": {
            "Address": "http://localhost:5002"
          }
        }
      },
      "core-cluster": {
        "Destinations": {
          "core-service": {
            "Address": "http://localhost:5003"
          }
        }
      }
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173"
    ]
  }
}
